# ============================================================================
# ONE AGENT BD — ENVIRONMENT VARIABLES (VERCEL + SUPABASE READY)
# ============================================================================

# 1. Google Gemini AI Key (Required for 24/7 AI Auto-Reply, Voice & Photo Search)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# 2. Supabase Cloud Database (Required for Permanent Data Storage on Vercel)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-or-anon-key"

# 3. Live Website URL (Set to your Vercel domain, e.g. https://oneagentbd.vercel.app)
APP_URL="https://your-domain.vercel.app"

# 4. Super Admin Credentials (Optional override for Admin Panel login)
ADMIN_EMAIL="admin@oneagentbd.online"
ADMIN_PASSWORD="Admin@OneAgentBD2026"

# 5. Meta (Facebook / Instagram / WhatsApp) Webhook & OAuth Config
WHATSAPP_VERIFY_TOKEN="one_agent_bd_verify_token"
MESSENGER_VERIFY_TOKEN="one_agent_bd_verify_token"
INSTAGRAM_VERIFY_TOKEN="one_agent_bd_verify_token"
META_APP_ID=""
META_APP_SECRET=""

# 6. Manual Payment Gateway Numbers (bKash / Nagad)
BKASH_PERSONAL_NUMBER="+8801700123456"
NAGAD_PERSONAL_NUMBER="+8801800123456"

